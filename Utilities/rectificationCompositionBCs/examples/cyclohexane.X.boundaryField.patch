// Example boundaryField snippets for cyclohexane.X
//
// Do NOT specify phi, samplePhi, A12Field, useA12Field, or constant A12.
//
// The liquid phase is detected from the single alpha.<phase> field in the
// case/registry. In incompressibleVoFTC this alpha field is the liquid volume
// fraction.
//
// Example:
//     0/alpha.liquid
//
// means:
//     liquid phase = liquid
//     gas phase    = the other phase in constant/phaseProperties
//
// The order in constant/phaseProperties is not used to choose the liquid phase.
// If phaseProperties contains:
//     phases (gas liquid);
// and the case contains:
//     0/alpha.liquid
// then the BCs still use:
//     Condensator: phi = alphaPhi.liquid, samplePhi = alphaPhi.gas
//     Boiler:      phi = alphaPhi.gas,    samplePhi = alphaPhi.liquid
//


// -------------------------------------------------------------------------
// Condensator / top patches
// -------------------------------------------------------------------------
//
// Measures outgoing gas composition and imposes incoming liquid composition.

top1
{
    type        inletOutletCondensator;
    group       topCondensator;
    value       uniform 0;
}

top2
{
    type        inletOutletCondensator;
    group       topCondensator;
    value       uniform 0;
}

top3
{
    type        inletOutletCondensator;
    group       topCondensator;
    value       uniform 0;
}


// -------------------------------------------------------------------------
// Boiler / bottom patches
// -------------------------------------------------------------------------
//
// Measures outgoing liquid composition and imposes the same value as
// incoming gas composition:
//
//     y_in,gas = x_out,liquid
//
// This is the total-reflux reboiler mass-balance closure which simulates a
// reservoir on steady state. from this composition and A12 the concentration
// of the fictional reservoir can be estimated by the fenskePatchData 
// post-processing function for example.

bottom1
{
    type        inletOutletBoiler;
    group       bottomBoiler;
    value       uniform 0;
}

bottom2
{
    type        inletOutletBoiler;
    group       bottomBoiler;
    value       uniform 0;
}

bottom3
{
    type        inletOutletBoiler;
    group       bottomBoiler;
    value       uniform 0;
}


// -------------------------------------------------------------------------
// Optional alternatives
// -------------------------------------------------------------------------

// Explicit patch list instead of group:
//
// top1
// {
//     type        inletOutletCondensator;
//     patches     (top1 top2 top3);
//     value       uniform 0;
// }

// Optional numerical damping:
//     relax       0.5;

// Optional clipping:
//     minValue    0;
//     maxValue    1;

// Optional minimum sampled flux:
//     minFlux     1e-300;
